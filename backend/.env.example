# Brightloop Backend Environment Variables
PROJECT_NAME="Brightloop Subscription Management System"
ENVIRONMENT="development"
DEBUG=true
PORT=8000
HOST="0.0.0.0"

# Security
SECRET_KEY="replace-with-a-secure-random-secret-key-in-production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database
# For local testing without PostgreSQL, SQLite can optionally be used:
# DATABASE_URL="sqlite:///./dev_test.db"
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/subscription_db"

# CORS
CORS_ORIGINS="http://localhost:5173,http://localhost:3000"

