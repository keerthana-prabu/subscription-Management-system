# Brightloop Subscription Management System - Global Environment Template
# Copy this file to .env in backend/ and frontend/ as needed for local development.

# --- Backend Configuration ---
PROJECT_NAME="Brightloop Subscription Management System"
ENVIRONMENT="development"
DEBUG=true
PORT=8000
HOST="0.0.0.0"

# Security (Generate a secure random string for production: `openssl rand -hex 32`)
SECRET_KEY="replace-with-a-secure-random-secret-key-in-production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# PostgreSQL Database Connection
# Format: postgresql://<username>:<password>@<host>:<port>/<database_name>
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/subscription_db"

# CORS Allowed Origins (Comma separated or JSON array)
CORS_ORIGINS="http://localhost:5173,http://localhost:3000"

# --- Frontend Configuration ---
VITE_API_BASE_URL="http://localhost:8000/api/v1"
VITE_APP_TITLE="Brightloop Subscriptions"

